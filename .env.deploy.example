# ===== 复制本文件为 .env.deploy 并填写（.env.deploy 已被 gitignore 忽略，不会提交）=====
# 留空的项在脚本中会被跳过（对应功能不可用，但部署仍可成功）。

# --- Cloudflare（必填，没有这俩无法部署）---
# 自定义令牌：权限 D1:Edit / R2 Buckets:Edit / Workers Scripts:Edit / Workers Routes:Edit（账户级）
CLOUDFLARE_API_TOKEN=
# Cloudflare 控制台右侧栏的 Account ID
CLOUDFLARE_ACCOUNT_ID=

# --- 自定义域名（可选；留空则部署到 *.workers.dev）---
CUSTOM_DOMAIN=

# --- 认证（建议填；不填则登录功能不可用）---
# 用 `openssl rand -base64 32` 生成一个，留空脚本会自动生成
BETTER_AUTH_SECRET=
# 站点地址，须与最终访问域名一致，如 https://qr.example.com
BETTER_AUTH_URL=
# GitHub → Settings → Developer settings → OAuth Apps 创建
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_CLIENT_SECRET=

# --- 邮件（可选；不填则不发验证/通知邮件）---
RESEND_API_KEY=
RESEND_SENDER_ADDRESS=QRManager <noreply@example.com>

# --- 上传/展示（可选；不填则 Logo 上传不可用）---
NEXT_PUBLIC_MAX_FILE_MB=10
# R2 桶的公网地址（需先在 Cloudflare R2 给 qr-manager-storage 开启公开访问或绑自定义域）
NEXT_PUBLIC_BUCKET_ADDRESS=
